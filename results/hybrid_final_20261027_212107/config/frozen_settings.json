  "selection_rules": {
    "attribution": "validation: maximise fault-classification accuracy (alarms are unchanged by attribution); ties -> shorter confirmation delay",
    "cusum": "calibration+validation runs: ARL0 (Siegmund) >= 10 x longest error series; then fewest false alarms (control runs + pre-onset alarms), most detected drift runs, lowest median delay, largest ARL0",
    "joint": "validation: the top-6 transient and top-4 persistent/stuck configurations (by their component objectives) are combined and re-ranked by full hybrid event F1 (latched drift, first-alarm attribution); ties -> fewer false alarms per hour",
    "lifecycle": "validation: among lifecycle options within 0.01 event F1 of the best, choose the fewest post-fault alarm records (overhang), then fewer false alarms per hour",
    "persistent_stuck": "validation: maximise event F1 over {offset_shift, gain_change, stuck_signal} for the persistent+stuck components; ties -> fewer false alarms per hour",
    "transient": "validation: maximise transient event F1 = harmonic mean of macro timely recall over {isolated_spike, abrupt_change} and the transient component's episode precision; ties -> fewer false alarms per hour"
  }
